<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HpVictusControl</AssemblyName>
    <RootNamespace>HpVictusControl</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.5.0</Version>
    <!-- Shown as the name in Task Manager and the file's properties; the exe keeps its old file name so
         existing installs, the startup task and self-update carry on working. -->
    <Product>Victus Hub</Product>
    <AssemblyTitle>Victus Hub</AssemblyTitle>
    <!-- A single-file publish otherwise leaves WPF's native DLLs (PresentationNative_cor3.dll and
         friends) beside the exe; copied on its own (e.g. into Program Files) it then crashes at
         start with DllNotFoundException. Bundled, the exe works wherever it's put. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Alexandria (SIL Open Font License, see Fonts\OFL.txt) for the Arabic interface -->
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>
</Project>
