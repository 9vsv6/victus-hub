<Window x:Class="HpVictusControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP Victus Control" Height="640" Width="560"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <!-- Linen (light) defaults; ApplyTheme swaps in Linen or its dark counterpart at start -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5E8B62"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4E7A53"/>
        <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FBF8F1"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E2D9C8"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#EAE3D5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3C3836"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#857C6C"/>
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#BDB4A4"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1EBDF"/>
        <SolidColorBrush x:Key="GlowFillBrush" Color="#E4EDE0"/>
        <!-- The halo behind selected controls. Static (effects can't follow a theme switch), so it's a
             sage that sits between the light and dark accents, and kept faint in both. -->
        <Color x:Key="AccentColorRaw">#7FA383</Color>
        <!-- Dial colours once a temperature stops being comfortable -->
        <SolidColorBrush x:Key="GaugeWarmBrush" Color="#D97706"/>
        <SolidColorBrush x:Key="GaugeHotBrush" Color="#DC2626"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="HeroStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Segmented-control style radio button (performance mode, top-level tabs, etc.) -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.25" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left sidebar navigation item: icon over label, highlighted when active -->
        <Style x:Key="SidebarNavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Padding="0,12" Margin="0,0,0,6"
                                BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="19" Height="19" HorizontalAlignment="Center">
                                    <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                          Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.22" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern checkbox: rounded box with accent fill + checkmark -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M4,9.5 L7.5,13 L14,4.5" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glow toggle switch: label left, sliding pill right, glows when on -->
        <Style x:Key="GlowToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <!-- The switch is placed first so it always gets its full size; the label takes
                             what's left and wraps, rather than pushing the switch out of a narrow card
                             (Arabic labels in Alexandria run noticeably wider). -->
                        <DockPanel LastChildFill="True">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="20" CornerRadius="10" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TrackBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.3" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern slider: thin track, accent fill, round thumb -->
        <Style x:Key="ModernThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.3" Color="{StaticResource AccentColorRaw}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillButton}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TrackBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text-only action for secondary things like "Open downloads folder" -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Performance mode as a stack of cards in the rail, instead of a segmented strip -->
        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1" CornerRadius="10" Padding="8,13">
                            <StackPanel HorizontalAlignment="Center">
                                <Path x:Name="Icon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center"
                                      Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outlined accent button: for actions repeated on every row, where solid green would shout -->
        <Style x:Key="OutlineAccentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, theme-matched scrollbar (applies to every ScrollViewer's internal ScrollBar) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" CornerRadius="3" Width="6"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource BorderBrush2}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- The whole interface is scaled to the window (see UpdateInterfaceScale): text, icons and
         buttons grow on a large or maximized window and shrink a little on a small one, while the
         layout still reflows to fill the width. ScaleHost is the unscaled frame it's measured by. -->
    <Border x:Name="ScaleHost" SizeChanged="ScaleHost_SizeChanged">
    <Grid x:Name="RootLayout" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar navigation -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <RadioButton x:Name="PerformanceTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M13 2 4 14h6l-1 8 9-12h-6l1-8z" Content="Performance"
                         GroupName="TopTab" IsChecked="True" Checked="TopTab_Changed"/>
            <RadioButton x:Name="DriversTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Content="Drivers"
                         GroupName="TopTab" Checked="TopTab_Changed"/>
            <RadioButton x:Name="SystemTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="F0 M4 4h16a1 1 0 0 1 1 1v11H3V5a1 1 0 0 1 1-1z M5 6v8h14V6z M1 17h22v1.5A1.5 1.5 0 0 1 21.5 20h-19A1.5 1.5 0 0 1 1 18.5z"
                         Content="System" GroupName="TopTab" Checked="TopTab_Changed"/>
            <RadioButton x:Name="SettingsTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z"
                         Content="Settings" GroupName="TopTab" Checked="TopTab_Changed"/>
        </StackPanel>

        <!-- Content area -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="1250">
            <!-- Support / status banner -->
            <Border x:Name="StatusBanner" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                    CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" Foreground="#664D03" FontSize="12"/>
            </Border>

            <!-- After a crash that closed the app: says so once, with the report to copy -->
            <Border x:Name="CrashNoticeCard" Style="{StaticResource Card}" BorderBrush="{DynamicResource GaugeWarmBrush}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="HP Victus Control closed unexpectedly last time" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="CrashNoticeText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Copy report" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"
                                Click="CopyCrashReport_Click"/>
                        <Button Content="Dismiss" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                Click="DismissCrashNotice_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- What's new: shown once after the app updates, above whichever page is open -->
            <Border x:Name="WhatsNewCard" Style="{StaticResource HeroCard}" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="WhatsNewTitleText" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <StackPanel x:Name="WhatsNewList"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Got it" Style="{StaticResource PrimaryButton}" Padding="18,8"
                            VerticalAlignment="Top" Margin="16,0,0,0" Click="WhatsNewDismiss_Click"/>
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <!-- Capped and centred: on a wide window the cards would otherwise stretch to the full
                 1900 px, leaving dials, sliders and buttons marooned at opposite edges. -->
            <Grid MaxWidth="1250">

                <!-- ===================== Performance tab ===================== -->
                <StackPanel x:Name="PerformanceTabPanel">

                    <!-- Section bar: switches between the performance controls and the games list, and keeps
                         temperatures and the active mode in view on either one. -->
                    <Border Style="{StaticResource Card}" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PerformanceSectionRadio" GroupName="PerformanceSection" IsChecked="True"
                                             Style="{StaticResource SegmentRadio}" Padding="14,6" Checked="PerformanceSection_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4 17a8 8 0 1 1 16 0 M12 17 16 10" Width="13" Height="13" Stretch="Uniform"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,7,0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <TextBlock Text="Performance"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="GamesSectionRadio" GroupName="PerformanceSection"
                                             Style="{StaticResource SegmentRadio}" Padding="14,6" Checked="PerformanceSection_Changed">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M7 8h10a4 4 0 0 1 4 4v2a3 3 0 0 1-5.2 2L14 14h-4l-1.8 2A3 3 0 0 1 3 14v-2a4 4 0 0 1 4-4z M7 11v2 M6 12h2 M15.5 12h.01 M17.5 11h.01"
                                              Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" Margin="0,0,7,0"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                        <TextBlock Text="Games"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock x:Name="SectionStatusText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0,10,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- ===== Performance section ===== -->
                    <StackPanel x:Name="PerformanceSectionPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ModeRailColumn" Width="146"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Mode rail: the controls worth reaching for without scrolling -->
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <RadioButton x:Name="BalancedRadio" GroupName="Mode" Style="{StaticResource ModeCard}"
                                             Tag="M12 3v18 M5 8h14 M5 8l-3 7h6z M19 8l3 7h-6z" Content="Balanced"
                                             ToolTip="Everyday mix of speed and quiet" Checked="ModeRadio_Checked"/>
                                <RadioButton x:Name="PerformanceRadio" GroupName="Mode" Style="{StaticResource ModeCard}"
                                             Tag="M12 2c3.5 3 5 6.5 5 10a5 5 0 0 1-10 0c0-3.5 1.5-7 5-10z M9 19c-1.5 1-2 2-2 3 1.5 0 2.5-.5 3.5-1.5 M15 19c1.5 1 2 2 2 3-1.5 0-2.5-.5-3.5-1.5"
                                             Content="Performance" ToolTip="Full speed, loudest and hottest" Checked="ModeRadio_Checked"/>
                                <RadioButton x:Name="CoolRadio" GroupName="Mode" Style="{StaticResource ModeCard}"
                                             Tag="M12 2v20 M4 7l16 10 M20 7L4 17 M12 6l-3 3 M12 6l3 3 M12 18l-3-3 M12 18l3-3"
                                             Content="Cool" ToolTip="Quietest, coolest, saves battery" Checked="ModeRadio_Checked"/>

                                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                    <CheckBox x:Name="MaxFanCheckBox" Content="Max fan" Style="{StaticResource GlowToggle}"
                                              ToolTip="Runs both fans flat out"
                                              Checked="MaxFanCheckBox_Changed" Unchecked="MaxFanCheckBox_Changed"/>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="AutoFanCheckBox" Content="Auto fan" Style="{StaticResource GlowToggle}"
                                                  ToolTip="Ramps each fan with its own temperature instead of the BIOS's built-in curve"
                                                  Checked="AutoFanCheckBox_Changed" Unchecked="AutoFanCheckBox_Changed"/>
                                        <TextBlock Text="by temperature" FontSize="10" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock x:Name="RefreshRateLabel" Text="Refresh rate" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <!-- Equal-width options across the rail, so "144Hz" can't run off the edge -->
                                        <Border x:Name="RefreshRateTrack" Background="{DynamicResource TrackBrush}" CornerRadius="9">
                                            <UniformGrid x:Name="RefreshRateOptionsPanel" Rows="1"/>
                                        </Border>
                                        <TextBlock x:Name="RefreshRateStatusText" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Battery time per mode, learned while on battery -->
                                <Border x:Name="BatteryTimeCard" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Battery time" FontSize="10" Margin="0,0,0,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Grid x:Name="BatteryTimeGrid"/>
                                        <TextBlock x:Name="BatteryTimeHintText" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Live stats: a dial per temperature, details underneath -->
                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource HeroCard}">
                                    <StackPanel>
                                        <TextBlock Text="Live stats" Style="{StaticResource SectionHeader}"/>
                                        <!-- Dials on the left, the numbers beside them: one dial per half of the
                                             card left a hole in the middle of a wide window. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Viewbox Grid.Column="0" Width="165">
                                                <Canvas Width="120" Height="104">
                                                    <Path Data="M14,76 A46,46 0 0 1 106,76" Stroke="{DynamicResource TrackBrush}"
                                                          StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path x:Name="CpuGaugeArc" Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <TextBlock x:Name="TemperatureText" Text="--°C" Canvas.Top="44" Width="120" TextAlignment="Center"
                                                               FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Grid Canvas.Top="84" Width="120">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="CPU · " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock x:Name="CpuUsageText" Text="--%" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Canvas>
                                            </Viewbox>

                                            <Viewbox Grid.Column="1" Width="165" Margin="16,0,0,0">
                                                <Canvas Width="120" Height="104" x:Name="GpuTempPanel"
                                                        ToolTip="Not available — no NVIDIA GPU detected (reads via nvidia-smi).">
                                                    <Path Data="M14,76 A46,46 0 0 1 106,76" Stroke="{DynamicResource TrackBrush}"
                                                          StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Path x:Name="GpuGaugeArc" Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="11" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <TextBlock x:Name="GpuTempText" Text="N/A" Canvas.Top="44" Width="120" TextAlignment="Center"
                                                               FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Grid x:Name="GpuUsagePanel" Canvas.Top="84" Width="120">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <TextBlock Text="GPU · " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock x:Name="GpuUsageText" Text="N/A" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Canvas>
                                            </Viewbox>

                                            <!-- A size up from the old 11 px: beside dials this big, the readings
                                                 looked like footnotes. -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="28,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="RAM " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock x:Name="RamText" Text="--%" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="RamDetailText" Text="" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="BatteryStatusText" Text="Battery --" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock x:Name="GpuDetailText" Text="" FontSize="12.5" Margin="0,12,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                                <TextBlock x:Name="IntelGpuDetailText" Text="" FontSize="12.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Fan speeds and the manual override -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Fan control" Style="{StaticResource SectionHeader}"/>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="CPU FAN" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="CpuFanText" Text="-- RPM" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="GPU FAN" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="GpuFanText" Text="-- RPM" Style="{StaticResource StatValue}"/>
                                            </StackPanel>
                                        </Grid>

                                        <CheckBox x:Name="ManualCheckBox" Content="Manual fan speed" Style="{StaticResource ModernCheckBox}"
                                                  Checked="ManualCheckBox_Changed" Unchecked="ManualCheckBox_Changed"/>

                                        <Grid Margin="0,12,0,0" IsEnabled="{Binding ElementName=ManualCheckBox, Path=IsChecked}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <!-- Two thirds of the row: a slider stretched across a 1250 px card is
                                                     needlessly long and hard to place precisely. -->
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource FieldLabel}"/>
                                            <Slider x:Name="CpuFanSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="60"
                                                    Margin="10,0" Style="{StaticResource ModernSlider}" ValueChanged="FanSlider_ValueChanged"/>
                                            <TextBlock x:Name="CpuFanSliderText" Grid.Row="0" Grid.Column="2" Text="0" Style="{StaticResource FieldValue}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                                            <Slider x:Name="GpuFanSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="60"
                                                    Margin="10,14,10,0" Style="{StaticResource ModernSlider}" ValueChanged="FanSlider_ValueChanged"/>
                                            <TextBlock x:Name="GpuFanSliderText" Grid.Row="1" Grid.Column="2" Text="0" Style="{StaticResource FieldValue}" Margin="0,14,0,0"/>
                                        </Grid>

                                        <Button x:Name="ApplyFanButton" Content="Apply fan speed" Style="{StaticResource PrimaryButton}"
                                                Margin="0,14,0,0" Padding="18,8" HorizontalAlignment="Right"
                                                IsEnabled="False" Click="ApplyFanButton_Click"/>

                                        <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                                        <CheckBox x:Name="AutoPowerCheckBox" Content="Auto-switch by power source" Style="{StaticResource GlowToggle}"
                                                  Checked="AutoPowerCheckBox_Changed" Unchecked="AutoPowerCheckBox_Changed"/>
                                        <TextBlock Text="Performance when plugged in, Cool on battery" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,0"/>

                                        <TextBlock x:Name="CycleModeTipText" Text="Tip: press Ctrl+Alt+F12 anywhere to cycle performance mode" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- NVIDIA power limit and Dynamic Boost, where the BIOS offers them -->
                                <Border x:Name="GpuPowerCard" Style="{StaticResource Card}" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="GPU power" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox x:Name="GpuTgpCheckBox" Content="Higher power limit" Style="{StaticResource GlowToggle}"
                                                  Checked="GpuPowerCheckBox_Changed" Unchecked="GpuPowerCheckBox_Changed"/>
                                        <TextBlock Text="Lets the NVIDIA GPU draw more power (custom TGP): more fps, more heat" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,0"/>
                                        <CheckBox x:Name="GpuBoostCheckBox" Content="Dynamic Boost" Style="{StaticResource GlowToggle}" Margin="0,14,0,0"
                                                  Checked="GpuPowerCheckBox_Changed" Unchecked="GpuPowerCheckBox_Changed"/>
                                        <TextBlock Text="Moves power from the CPU to the GPU when the CPU doesn't need it" FontSize="11"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,0"/>
                                        <TextBlock x:Name="GpuPowerStatusText" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- What happens while nobody is at the keyboard -->
                                <Border x:Name="IdleCard" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="When you step away" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox x:Name="IdleCoolCheckBox" Content="Cool mode when idle" Style="{StaticResource GlowToggle}"
                                                  Checked="IdleCoolCheckBox_Changed" Unchecked="IdleCoolCheckBox_Changed"/>
                                        <TextBlock Text="Quiets the fans after no mouse or keyboard input, and switches back as soon as you return. Not while a game from your list is running."
                                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,8"/>
                                        <Border Background="{DynamicResource TrackBrush}" CornerRadius="9" MaxWidth="360" HorizontalAlignment="Left"
                                                Margin="26,0,0,0" IsEnabled="{Binding ElementName=IdleCoolCheckBox, Path=IsChecked}">
                                            <UniformGrid x:Name="IdleCoolMinutesPanel" Rows="1">
                                                <RadioButton Content="2 min" Tag="2" GroupName="IdleCoolMinutes" Style="{StaticResource SegmentRadio}" Checked="IdleCoolMinutes_Checked"/>
                                                <RadioButton Content="5 min" Tag="5" GroupName="IdleCoolMinutes" Style="{StaticResource SegmentRadio}" Checked="IdleCoolMinutes_Checked"/>
                                                <RadioButton Content="10 min" Tag="10" GroupName="IdleCoolMinutes" Style="{StaticResource SegmentRadio}" Checked="IdleCoolMinutes_Checked"/>
                                                <RadioButton Content="20 min" Tag="20" GroupName="IdleCoolMinutes" Style="{StaticResource SegmentRadio}" Checked="IdleCoolMinutes_Checked"/>
                                            </UniformGrid>
                                        </Border>

                                        <StackPanel x:Name="KeyboardBacklightPanel" Visibility="Collapsed">
                                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>
                                            <CheckBox x:Name="KeyboardBacklightCheckBox" Content="Keyboard backlight" Style="{StaticResource GlowToggle}"
                                                      Checked="KeyboardBacklightCheckBox_Changed" Unchecked="KeyboardBacklightCheckBox_Changed"/>
                                            <TextBlock Text="Turn it off after no input for" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,8"/>
                                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="9" MaxWidth="360" HorizontalAlignment="Left" Margin="26,0,0,0">
                                                <UniformGrid x:Name="BacklightTimeoutPanel" Rows="1">
                                                    <RadioButton Content="Never" Tag="0" GroupName="BacklightTimeout" Style="{StaticResource SegmentRadio}" Checked="BacklightTimeout_Checked"/>
                                                    <RadioButton Content="30 s" Tag="30" GroupName="BacklightTimeout" Style="{StaticResource SegmentRadio}" Checked="BacklightTimeout_Checked"/>
                                                    <RadioButton Content="1 min" Tag="60" GroupName="BacklightTimeout" Style="{StaticResource SegmentRadio}" Checked="BacklightTimeout_Checked"/>
                                                    <RadioButton Content="5 min" Tag="300" GroupName="BacklightTimeout" Style="{StaticResource SegmentRadio}" Checked="BacklightTimeout_Checked"/>
                                                </UniformGrid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ===== Games section ===== -->
                    <StackPanel x:Name="GamesSectionPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Games" Style="{StaticResource SectionHeader}" Margin="0,0,8,4"/>
                                        <TextBlock x:Name="GameCountText" FontSize="11" Margin="0,1,0,4" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Mode, refresh rate and max fan switch on while a game runs and go back when it closes. The FPS cap is stored in the NVIDIA driver, the same as Control Panel's Max Frame Rate."/>
                                    <TextBlock x:Name="GameScanStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                    <CheckBox x:Name="TuneWifiCheckBox" Content="Tune Wi-Fi while playing" Style="{StaticResource GlowToggle}"
                                              Margin="0,12,0,0" HorizontalAlignment="Left" MinWidth="320"
                                              Checked="TuneWifiCheckBox_Changed" Unchecked="TuneWifiCheckBox_Changed"
                                              ToolTip="While any game in this list runs, stops Windows scanning for other Wi-Fi networks in the background — the usual cause of lag spikes that repeat about once a minute."/>
                                    <CheckBox x:Name="AutoAddGamesCheckBox" Content="Add games as you play them" Style="{StaticResource GlowToggle}"
                                              Margin="0,10,0,0" HorizontalAlignment="Left" MinWidth="320"
                                              Checked="AutoAddGamesCheckBox_Changed" Unchecked="AutoAddGamesCheckBox_Changed"
                                              ToolTip="When a game starts from a Steam, Epic, Xbox, GOG or Battle.net library and isn't in this list yet, it's added with nothing switched on."/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button x:Name="BrowseForGameButton" Content="Add game..." Style="{StaticResource SecondaryButton}"
                                            Padding="14,8" Margin="0,0,8,0" Click="BrowseForGameButton_Click"/>
                                    <Button Content="Scan for games" Style="{StaticResource PrimaryButton}"
                                            Padding="16,8" Click="ScanForGamesButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="NoGameProfilesText" Text="No games yet. Scan to find your Steam and Epic games." FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,14"/>
                        <!-- One card per game, two per row when there's room (see GameProfilesListPanel_SizeChanged).
                             The negative margin cancels the cards' own side gutters so their edges line up with the header. -->
                        <UniformGrid x:Name="GameProfilesListPanel" Columns="2" Margin="-7,0" VerticalAlignment="Top"
                                     SizeChanged="GameProfilesListPanel_SizeChanged"/>
                    </StackPanel>

                </StackPanel>

                <!-- ===================== Drivers tab ===================== -->
                <StackPanel x:Name="DriversTabPanel" Visibility="Collapsed">

                    <!-- Before a check, while checking, or with nothing to install: one clear action in the
                         middle instead of two buttons in the corner of an empty page -->
                    <Border x:Name="UpdatesEmptyState" Style="{StaticResource Card}" Padding="32,44">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="540">
                            <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                                    Background="{DynamicResource GlowFillBrush}">
                                <Path Data="M12 3v12 M7 10l5 5 5-5 M5 21h14" Width="22" Height="22" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitleText" Text="Driver &amp; BIOS updates" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="EmptyStatusText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Looks up real updates for this exact laptop from HP, NVIDIA and Intel — nothing is installed automatically."/>
                            <Button x:Name="EmptyCheckButton" Content="Check for updates" Style="{StaticResource PrimaryButton}"
                                    Padding="30,11" Margin="0,20,0,0" HorizontalAlignment="Center" Click="CheckUpdatesButton_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock x:Name="EmptyLastCheckedText" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                                <Button Content="Open downloads folder" Style="{StaticResource LinkButton}"
                                        Click="OpenDownloadsFolderButton_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- With updates listed: what was found, when, and the buttons to check again -->
                    <Border x:Name="UpdatesHeaderCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="UpdatesTitleText" Text="Driver &amp; BIOS updates" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="UpdatesStatusText" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Looks up real updates for this exact laptop from HP, NVIDIA and Intel — nothing is installed automatically."/>
                                <TextBlock x:Name="LastCheckedText" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button Content="Open downloads folder" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" Margin="0,0,8,0" Click="OpenDownloadsFolderButton_Click"/>
                                <Button x:Name="CheckUpdatesButton" Content="Check for updates" Style="{StaticResource PrimaryButton}"
                                        Padding="16,8" Click="CheckUpdatesButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Updates: filter rail, list, and a details pane that opens on click -->
                    <Border x:Name="UpdatesTableCard" Style="{StaticResource Card}" Padding="12" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Filter rail, filled in code so the counts stay honest -->
                            <Border Grid.Column="0" Width="168" CornerRadius="9" Padding="6"
                                    Background="{DynamicResource WindowBackgroundBrush}">
                                <StackPanel x:Name="UpdateFiltersPanel"/>
                            </Border>

                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- The actions drop to a second row when the details pane leaves too little width -->
                                <Grid x:Name="BulkActionsBar" Margin="0,0,0,8" SizeChanged="BulkActionsBar_SizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Search takes whatever room is left, so the sort button is never cut off -->
                                    <Grid x:Name="SearchSortGrid" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="80" MaxWidth="240"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="8" Padding="9,6" Background="{DynamicResource TrackBrush}">
                                            <Grid>
                                                <TextBlock x:Name="UpdateSearchHint" Text="Search updates" FontSize="12" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBox x:Name="UpdateSearchBox" BorderThickness="0" Background="Transparent" FontSize="12"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" TextChanged="UpdateSearchBox_TextChanged"/>
                                            </Grid>
                                        </Border>
                                        <Button x:Name="UpdateSortButton" Grid.Column="1" Content="Newest first" Style="{StaticResource SecondaryButton}"
                                                Padding="12,6" Margin="8,0,0,0" Click="UpdateSortButton_Click"
                                                ToolTip="Click to change the order"/>
                                    </Grid>

                                    <CheckBox x:Name="SelectAllCheckBox" Grid.Column="1" Content="Select all" Style="{StaticResource ModernCheckBox}"
                                              VerticalAlignment="Center" Margin="12,0,10,0"
                                              Checked="SelectAllCheckBox_Changed" Unchecked="SelectAllCheckBox_Changed"/>
                                    <Button x:Name="DownloadSelectedButton" Grid.Column="2" Content="Download selected" Style="{StaticResource SecondaryButton}"
                                            Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="DownloadSelectedButton_Click"/>
                                    <Button x:Name="InstallSelectedButton" Grid.Column="3" Content="Install selected" Style="{StaticResource PrimaryButton}"
                                            Padding="12,6" IsEnabled="False" Click="InstallSelectedButton_Click"/>
                                </Grid>

                                <StackPanel Grid.Row="1">
                                    <StackPanel x:Name="UpdatesListPanel" SizeChanged="UpdatesListPanel_SizeChanged"/>
                                    <TextBlock x:Name="SelectionSummaryText" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Details for the clicked update; hidden until then -->
                            <Border x:Name="UpdateDetailsPane" Grid.Column="2" Width="290" Margin="12,0,0,0" CornerRadius="9"
                                    Background="{DynamicResource WindowBackgroundBrush}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid Margin="14,12,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:Name="UpdateDetailsTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock x:Name="UpdateDetailsSubtitle" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button x:Name="CloseUpdateDetailsButton" Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButton}"
                                                Padding="8,2" VerticalAlignment="Top" Click="CloseUpdateDetailsButton_Click" ToolTip="Close"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource BorderBrush2}"/>
                                    <StackPanel x:Name="UpdateDetailsContent" Margin="14,10,14,14"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ===================== System tab ===================== -->
                <StackPanel x:Name="SystemTabPanel" Visibility="Collapsed">

                    <!-- This laptop -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="This laptop" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="SystemInfoStatusText" Text="Reading system details…" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Check warranty" Style="{StaticResource SecondaryButton}" Padding="14,8" Margin="0,0,8,0"
                                            ToolTip="Opens HP's warranty check page" Click="CheckWarrantyButton_Click"/>
                                    <Button x:Name="CopySystemInfoButton" Content="Copy details" Style="{StaticResource PrimaryButton}" Padding="16,8"
                                            IsEnabled="False" Click="CopySystemInfoButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="SystemInfoGrid" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Battery health -->
                    <Border x:Name="BatteryHealthCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Battery health" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BatteryHealthPercentText" Text="--%" Style="{StaticResource HeroStatValue}"
                                           Margin="0,0,18,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="BatteryHealthSummaryText" Text="Reading the battery report…" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="BatteryHealthDetailText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Height="8" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="BatteryHealthFillColumn" Width="0*"/>
                                    <ColumnDefinition x:Name="BatteryHealthRestColumn" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{DynamicResource TrackBrush}"/>
                                <Border x:Name="BatteryHealthBar" CornerRadius="4" Background="{DynamicResource AccentBrush}"/>
                            </Grid>
                            <TextBlock x:Name="BatteryHealthAdviceText" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Drive health: temperature and remaining write endurance -->
                    <Border x:Name="DiskHealthCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Drive health" Style="{StaticResource SectionHeader}"/>
                                <Button x:Name="RefreshDiskHealthButton" Grid.Column="1" Content="Refresh"
                                        Style="{StaticResource SecondaryButton}" Padding="12,6" VerticalAlignment="Top"
                                        Click="RefreshDiskHealthButton_Click"/>
                            </Grid>
                            <StackPanel x:Name="DiskHealthPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- Graphics mode (BIOS graphics switch / MUX); hidden on laptops that don't have one -->
                    <Border x:Name="GraphicsModeCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Graphics mode" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="GraphicsModeStatusText" Text="Checking the BIOS…" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Border x:Name="GraphicsModeTrack" Background="{DynamicResource TrackBrush}" CornerRadius="9"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="HybridGpuRadio" Content="Hybrid" GroupName="GpuMode" Style="{StaticResource SegmentRadio}"
                                                 Padding="16,7" Checked="GpuModeRadio_Checked"
                                                 ToolTip="Intel GPU drives the screen, NVIDIA renders games. Longer battery life."/>
                                    <RadioButton x:Name="DiscreteGpuRadio" Content="NVIDIA only" GroupName="GpuMode" Style="{StaticResource SegmentRadio}"
                                                 Padding="16,7" Checked="GpuModeRadio_Checked"
                                                 ToolTip="NVIDIA GPU drives the screen directly. More fps, shorter battery life."/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="GraphicsModeHintText" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <Button x:Name="RestartNowButton" Content="Restart now" Style="{StaticResource SecondaryButton}"
                                    Padding="16,8" Margin="0,10,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Click="RestartNowButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- BIOS: a few harmless setup options, and a way into the setup screen itself -->
                    <Border x:Name="BiosSettingsCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="BIOS settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="BiosSettingsStatusText" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="The same options as the BIOS setup screen. Changes are saved to the BIOS and take effect after a restart."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Restart into BIOS" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" VerticalAlignment="Top" Click="RestartIntoBiosButton_Click"
                                        ToolTip="Restarts straight into the BIOS setup screen"/>
                            </Grid>
                            <StackPanel x:Name="BiosSettingsPanel" Margin="0,6,0,0"/>
                            <Button x:Name="BiosRestartToApplyButton" Content="Restart to apply" Style="{StaticResource PrimaryButton}"
                                    Padding="16,8" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Click="RestartNowButton_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Maintenance -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Maintenance" Style="{StaticResource SectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Fan test" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Runs both fans at full speed for 15 seconds and checks they spin up properly" FontSize="11"
                                               Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="FanTestButton" Grid.Column="1" Content="Test fans" Style="{StaticResource SecondaryButton}"
                                        MinWidth="130" Padding="14,8" Click="FanTestButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="FanTestResultText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Visibility="Collapsed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Shader cache" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="ShaderCacheSizeText" Text="Measuring…" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="ClearShaderCacheButton" Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButton}"
                                        MinWidth="130" Padding="14,8" IsEnabled="False" Click="ClearShaderCacheButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Driver downloads" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="DriverDownloadsSizeText" Text="Measuring…" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="CleanDriverDownloadsButton" Grid.Column="1" Content="Clean up" Style="{StaticResource SecondaryButton}"
                                        MinWidth="130" Padding="14,8" IsEnabled="False" Click="CleanDriverDownloadsButton_Click"/>
                            </Grid>
                            <CheckBox x:Name="AutoCleanDownloadsCheckBox" Content="Clean up automatically" Style="{StaticResource GlowToggle}"
                                      Margin="0,12,0,0" Checked="AutoCleanDownloadsCheckBox_Changed" Unchecked="AutoCleanDownloadsCheckBox_Changed"/>
                            <TextBlock Text="Deletes each installer once it has installed successfully, and any left over for 30 days" FontSize="11"
                                       Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===================== Settings tab ===================== -->
                <StackPanel x:Name="SettingsTabPanel" Visibility="Collapsed">

                    <!-- Appearance -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="MatchWindowsThemeCheckBox" Content="Match Windows' light or dark theme" Style="{StaticResource GlowToggle}"
                                      Checked="MatchWindowsThemeCheckBox_Changed" Unchecked="MatchWindowsThemeCheckBox_Changed"/>
                            <TextBlock Text="Switches along with Windows (Settings → Personalization → Colors)" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="DarkThemeCheckBox" Content="Dark theme" Style="{StaticResource GlowToggle}"
                                      Checked="DarkThemeCheckBox_Changed" Unchecked="DarkThemeCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Interface size" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="InterfaceSizeHintText" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Border x:Name="InterfaceSizeHost" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Language" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Arabic uses a right-to-left layout. Applies after a restart." FontSize="11" Margin="0,3,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Border x:Name="LanguageHost" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Style="{StaticResource GlowToggle}"
                                      Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Sound -->
                    <Border x:Name="SpeakerAwakeCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sound" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="KeepSpeakersAwakeCheckBox" Content="Keep speakers awake" Style="{StaticResource GlowToggle}"
                                      Checked="KeepSpeakersAwakeCheckBox_Changed" Unchecked="KeepSpeakersAwakeCheckBox_Changed"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Stops the audio chip powering down after a few seconds of silence, which makes the next sound (like a UAC prompt's) start late. Uses a little more battery, and a Realtek driver update may undo it."/>
                            <TextBlock x:Name="SpeakerAwakeStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Keyboard shortcuts -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="These work anywhere, even in a game. Click a shortcut, then press the new keys — it needs Ctrl, Alt or Win. Backspace turns it off, Esc cancels."/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Toggle max fan" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Turns max fan speed on or off" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="MaxFanHotkeyButton" Grid.Column="1" Tag="MaxFan" Style="{StaticResource SecondaryButton}"
                                        MinWidth="160" Padding="14,8" Margin="12,0,0,0"
                                        Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                        PreviewKeyUp="HotkeyButton_PreviewKeyUp" LostKeyboardFocus="HotkeyButton_LostKeyboardFocus"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,12,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cycle performance mode" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Balanced → Performance → Cool" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="CycleModeHotkeyButton" Grid.Column="1" Tag="CycleMode" Style="{StaticResource SecondaryButton}"
                                        MinWidth="160" Padding="14,8" Margin="12,0,0,0"
                                        Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"
                                        PreviewKeyUp="HotkeyButton_PreviewKeyUp" LostKeyboardFocus="HotkeyButton_LostKeyboardFocus"/>
                            </Grid>

                            <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Alerts & startup -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alerts &amp; startup" Style="{StaticResource SectionHeader}"/>

                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows (minimized to tray)"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="WeeklyDriverCheckCheckBox" Content="Check for driver updates every week"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="WeeklyDriverCheckCheckBox_Changed" Unchecked="WeeklyDriverCheckCheckBox_Changed"/>
                            <TextBlock Text="Checks HP, NVIDIA and Intel in the background and tells you when something new turns up. Nothing is installed without you."
                                       FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="ExitOnCloseCheckBox" Content="Exit instead of minimizing to tray when closed"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="ExitOnCloseCheckBox_Changed" Unchecked="ExitOnCloseCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="TempAlertCheckBox" Content="Notify when CPU or GPU gets too hot"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="TempAlertCheckBox_Changed" Unchecked="TempAlertCheckBox_Changed"/>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding ElementName=TempAlertCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="TempAlertSlider" Grid.Column="1" Minimum="60" Maximum="100"
                                        Margin="10,0" Style="{StaticResource ModernSlider}" ValueChanged="TempAlertSlider_ValueChanged"/>
                                <TextBlock x:Name="TempAlertSliderText" Grid.Column="2" Text="85°C" Style="{StaticResource FieldValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- About & support -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About &amp; support" Style="{StaticResource SectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppVersionText" Grid.Column="0" Text="Version --" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Button x:Name="CheckForAppUpdateButton" Grid.Column="1" Content="Check for app updates"
                                        Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CheckForAppUpdateButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="AppUpdateStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="InstallAppUpdateButton" Content="Update now" Style="{StaticResource PrimaryButton}"
                                        Padding="14,6" Margin="0,0,8,0" Visibility="Collapsed"
                                        ToolTip="Downloads the new build and puts it in place of this one"
                                        Click="InstallAppUpdateButton_Click"/>
                                <Button x:Name="OpenReleasePageButton" Content="View release" Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" Visibility="Collapsed" Click="OpenReleasePageButton_Click"/>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <!-- Installed in Program Files and listed in Windows' installed apps, or not -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Installation" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="InstallStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button x:Name="InstallButton" Grid.Column="1" Content="Install" Style="{StaticResource SecondaryButton}"
                                        Padding="14,8" VerticalAlignment="Center" Click="InstallButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Copy diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Copies hardware, driver, and live sensor info to the clipboard for bug reports."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        VerticalAlignment="Center" Click="CopyDiagnosticsButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Reset to defaults" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Resets all app preferences (theme, auto-switch, fan curve, alerts, game profiles) back to defaults."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reset" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        VerticalAlignment="Center" Click="ResetToDefaultsButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="FooterText" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                   Text="Closing this window minimizes to the tray. Use the tray icon to exit."/>
        </Grid>
    </Grid>
    </Border>
</Window>
