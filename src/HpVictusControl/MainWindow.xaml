<Window x:Class="HpVictusControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP Victus Control" Height="640" Width="560"
        MinHeight="480" MinWidth="480"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1CA84E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#E4E6EB"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#EEF0F3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1F24"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A8F98"/>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="GlowFillBrush" Color="#E8F9EF"/>
        <Color x:Key="AccentColorRaw">#22C55E</Color>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="HeroCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="HeroStatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <!-- Segmented-control style radio button (performance mode, top-level tabs, etc.) -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Padding" Value="0,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C7CBD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Left sidebar navigation item: icon over label, highlighted when active -->
        <Style x:Key="SidebarNavItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="10" Padding="0,12" Margin="0,0,0,6"
                                BorderThickness="1" BorderBrush="Transparent">
                            <StackPanel HorizontalAlignment="Center">
                                <Viewbox Width="19" Height="19" HorizontalAlignment="Center">
                                    <Path Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                          Fill="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Foreground}"/>
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.4" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern checkbox: rounded box with accent fill + checkmark -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource CardBrush}" VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M4,9.5 L7.5,13 L14,4.5" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C7CBD1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E4E6EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glow toggle switch: label left, sliding pill right, glows when on -->
        <Style x:Key="GlowToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel LastChildFill="False">
                            <ContentPresenter DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="20" CornerRadius="10"
                                    Background="{DynamicResource TrackBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush2}">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                        Background="{DynamicResource TextSecondaryBrush}"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource GlowFillBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Track" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="{StaticResource AccentColorRaw}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#C7CBD1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern slider: thin track, accent fill, round thumb -->
        <Style x:Key="ModernThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.5" Color="{StaticResource AccentColorRaw}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFillButton}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Primary action button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource TrackBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BorderBrush2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, theme-matched scrollbar (applies to every ScrollViewer's internal ScrollBar) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBorder" CornerRadius="3" Width="6"
                                                        HorizontalAlignment="Center"
                                                        Background="{DynamicResource BorderBrush2}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="MinHeight" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left sidebar navigation -->
        <StackPanel Grid.Column="0" Margin="0,0,12,0">
            <RadioButton x:Name="PerformanceTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M13 2 4 14h6l-1 8 9-12h-6l1-8z" Content="Performance"
                         GroupName="TopTab" IsChecked="True" Checked="TopTab_Changed"/>
            <RadioButton x:Name="DriversTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Content="Drivers"
                         GroupName="TopTab" Checked="TopTab_Changed"/>
            <RadioButton x:Name="SettingsTabRadio" Style="{StaticResource SidebarNavItem}"
                         Tag="M19.14,12.94c0.04,-0.3 0.06,-0.61 0.06,-0.94c0,-0.32 -0.02,-0.64 -0.07,-0.94l2.03,-1.58c0.18,-0.14 0.23,-0.41 0.12,-0.61l-1.92,-3.32c-0.12,-0.22 -0.37,-0.29 -0.59,-0.22l-2.39,0.96c-0.5,-0.38 -1.03,-0.7 -1.62,-0.94L14.4,2.81c-0.04,-0.24 -0.24,-0.41 -0.48,-0.41h-3.84c-0.24,0 -0.43,0.17 -0.47,0.41L9.25,5.35C8.66,5.59 8.12,5.92 7.63,6.29L5.24,5.33c-0.22,-0.08 -0.47,0 -0.59,0.22L2.74,8.87C2.62,9.08 2.66,9.34 2.86,9.48l2.03,1.58C4.84,11.36 4.8,11.69 4.8,12s0.02,0.64 0.07,0.94l-2.03,1.58c-0.18,0.14 -0.23,0.41 -0.12,0.61l1.92,3.32c0.12,0.22 0.37,0.29 0.59,0.22l2.39,-0.96c0.5,0.38 1.03,0.7 1.62,0.94l0.36,2.54c0.05,0.24 0.24,0.41 0.48,0.41h3.84c0.24,0 0.44,-0.17 0.47,-0.41l0.36,-2.54c0.59,-0.24 1.13,-0.56 1.62,-0.94l2.39,0.96c0.22,0.08 0.47,0 0.59,-0.22l1.92,-3.32c0.12,-0.22 0.07,-0.47 -0.12,-0.61L19.14,12.94zM12,15.6c-1.98,0 -3.6,-1.62 -3.6,-3.6s1.62,-3.6 3.6,-3.6s3.6,1.62 3.6,3.6S13.98,15.6 12,15.6z"
                         Content="Settings" GroupName="TopTab" Checked="TopTab_Changed"/>
        </StackPanel>

        <!-- Content area -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Support / status banner -->
        <Border x:Name="StatusBanner" Grid.Row="0" Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1"
                CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="StatusBannerText" TextWrapping="Wrap" Foreground="#664D03" FontSize="12"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- ===================== Performance tab ===================== -->
                <StackPanel x:Name="PerformanceTabPanel">

                    <!-- Live stats -->
                    <Border Style="{StaticResource HeroCard}">
                        <StackPanel>
                            <TextBlock Text="Live stats" Style="{StaticResource SectionHeader}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU TEMP" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="TemperatureText" Text="--°C" Style="{StaticResource HeroStatValue}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Margin="8,2" Background="{DynamicResource BorderBrush2}"/>
                                <StackPanel x:Name="GpuTempPanel" Grid.Column="2"
                                            ToolTip="Not available — no NVIDIA GPU detected (reads via nvidia-smi).">
                                    <TextBlock Text="GPU TEMP" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuTempText" Text="N/A" Style="{StaticResource HeroStatValue}"/>
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Margin="8,2" Background="{DynamicResource BorderBrush2}"/>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="CPU USAGE" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuUsageText" Text="--%" Style="{StaticResource HeroStatValue}"/>
                                </StackPanel>
                                <Border Grid.Column="5" Width="1" Margin="8,2" Background="{DynamicResource BorderBrush2}"/>
                                <StackPanel x:Name="GpuUsagePanel" Grid.Column="6"
                                            ToolTip="Not available — no NVIDIA GPU detected (reads via nvidia-smi).">
                                    <TextBlock Text="GPU USAGE" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuUsageText" Text="N/A" Style="{StaticResource HeroStatValue}"/>
                                </StackPanel>
                                <Border Grid.Column="7" Width="1" Margin="8,2" Background="{DynamicResource BorderBrush2}"/>
                                <StackPanel Grid.Column="8">
                                    <TextBlock Text="RAM" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="RamText" Text="-- GB" Style="{StaticResource HeroStatValue}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,10"/>
                            <TextBlock x:Name="BatteryStatusText" Text="Battery --"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="GpuDetailText" Text="" Margin="0,4,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <TextBlock x:Name="RamDetailText" Text="" Margin="0,4,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Performance mode -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Performance mode" Style="{StaticResource SectionHeader}"/>
                            <Border Background="{DynamicResource TrackBrush}" CornerRadius="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="BalancedRadio" Grid.Column="0" Content="Balanced" GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}" Checked="ModeRadio_Checked"/>
                                    <RadioButton x:Name="PerformanceRadio" Grid.Column="1" Content="Performance" GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}" Checked="ModeRadio_Checked"/>
                                    <RadioButton x:Name="CoolRadio" Grid.Column="2" Content="Cool" GroupName="Mode"
                                                 Style="{StaticResource SegmentRadio}" Checked="ModeRadio_Checked"/>
                                </Grid>
                            </Border>

                            <CheckBox x:Name="AutoPowerCheckBox" Content="Auto-switch by power source" Style="{StaticResource GlowToggle}"
                                      Margin="0,14,0,0" Checked="AutoPowerCheckBox_Changed" Unchecked="AutoPowerCheckBox_Changed"/>
                            <TextBlock Text="Performance when plugged in, Cool on battery" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,0"/>

                            <TextBlock x:Name="RefreshRateLabel" Text="Refresh rate" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
                            <Border x:Name="RefreshRateTrack" Background="{DynamicResource TrackBrush}" CornerRadius="9" HorizontalAlignment="Left">
                                <StackPanel x:Name="RefreshRateOptionsPanel" Orientation="Horizontal"/>
                            </Border>
                            <TextBlock x:Name="RefreshRateStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                            <TextBlock Text="Tip: press Ctrl+Alt+F12 anywhere to cycle performance mode" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Games -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Games" Style="{StaticResource SectionHeader}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Pick a mode for each game. The app switches to it while the game runs and switches back when it closes."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Scan for games" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0" Click="ScanForGamesButton_Click"/>
                                <Button x:Name="BrowseForGameButton" Grid.Column="1" Content="Add game..." Style="{StaticResource SecondaryButton}"
                                        Padding="14,10" Click="BrowseForGameButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="GameScanStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                            <TextBlock x:Name="NoGameProfilesText" Text="No games yet. Scan to find your Steam and Epic games." FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>
                            <StackPanel x:Name="GameProfilesListPanel" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Fan speed control -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fan speed" Style="{StaticResource SectionHeader}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CPU FAN" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="CpuFanText" Text="-- RPM" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GPU FAN" Style="{StaticResource StatLabel}"/>
                                    <TextBlock x:Name="GpuFanText" Text="-- RPM" Style="{StaticResource StatValue}"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ManualCheckBox" Content="Manual fan speed" Style="{StaticResource ModernCheckBox}"
                                      Checked="ManualCheckBox_Changed" Unchecked="ManualCheckBox_Changed"/>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding ElementName=ManualCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="CpuFanSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="60"
                                        Margin="10,0" Style="{StaticResource ModernSlider}" ValueChanged="FanSlider_ValueChanged"/>
                                <TextBlock x:Name="CpuFanSliderText" Grid.Row="0" Grid.Column="2" Text="0" Style="{StaticResource FieldValue}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="GPU" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                                <Slider x:Name="GpuFanSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="60"
                                        Margin="10,14,10,0" Style="{StaticResource ModernSlider}" ValueChanged="FanSlider_ValueChanged"/>
                                <TextBlock x:Name="GpuFanSliderText" Grid.Row="1" Grid.Column="2" Text="0" Style="{StaticResource FieldValue}" Margin="0,14,0,0"/>
                            </Grid>

                            <Button x:Name="ApplyFanButton" Content="Apply fan speed" Style="{StaticResource PrimaryButton}"
                                    Margin="0,16,0,0" IsEnabled="False" Click="ApplyFanButton_Click"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,16,0,16"/>

                            <CheckBox x:Name="AutoFanCheckBox" Content="Auto fan by temperature" Style="{StaticResource GlowToggle}"
                                      Checked="AutoFanCheckBox_Changed" Unchecked="AutoFanCheckBox_Changed"/>
                            <TextBlock Text="Ramps CPU/GPU fan speed with their own temperature instead of the BIOS's built-in curve"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,3,0,0" TextWrapping="Wrap"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,16,0,16"/>

                            <CheckBox x:Name="MaxFanCheckBox" Content="Force max fan speed" Style="{StaticResource GlowToggle}"
                                      Checked="MaxFanCheckBox_Changed" Unchecked="MaxFanCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Run apps on NVIDIA GPU -->
                    <Border x:Name="GpuPreferenceCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Run apps on NVIDIA GPU" Style="{StaticResource SectionHeader}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Sets Windows' per-app graphics preference to High performance, so these apps render on the NVIDIA GPU instead of Intel graphics. Takes effect the next time each app starts, and uses more power and heat."/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="All installed games" Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,0" Click="GpuApplyToGamesButton_Click"/>
                                <Button Grid.Column="1" Content="All open apps" Style="{StaticResource SecondaryButton}"
                                        Click="GpuApplyToOpenAppsButton_Click"/>
                            </Grid>
                            <Button Content="Add app..." Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                    Click="GpuAddAppButton_Click"/>

                            <TextBlock x:Name="GpuPreferenceStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>

                            <TextBlock x:Name="NoGpuPreferenceText" Text="No apps set to use the NVIDIA GPU yet." FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                            <StackPanel x:Name="GpuPreferenceListPanel" Margin="0,6,0,0"/>
                            <Button x:Name="ClearGpuPreferencesButton" Content="Remove all" Style="{StaticResource SecondaryButton}"
                                    Margin="0,8,0,0" Visibility="Collapsed" Click="ClearGpuPreferencesButton_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===================== Drivers tab ===================== -->
                <StackPanel x:Name="DriversTabPanel" Visibility="Collapsed">

                    <!-- Driver & BIOS updates -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Driver &amp; BIOS updates" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="UpdatesStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Looks up real updates for this exact laptop from HP's own support site — nothing is installed automatically."/>
                            <TextBlock x:Name="LastCheckedText" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CheckUpdatesButton" Grid.Column="0" Content="Check for updates"
                                        Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="CheckUpdatesButton_Click"/>
                                <Button Grid.Column="1" Content="Open downloads folder" Style="{StaticResource SecondaryButton}"
                                        Padding="12,10" Click="OpenDownloadsFolderButton_Click"/>
                            </Grid>

                            <Grid x:Name="SortBar" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Sort by" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" Background="{DynamicResource TrackBrush}" CornerRadius="9" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SortByDateRadio" Content="Newest" GroupName="SortMode"
                                                     Style="{StaticResource SegmentRadio}" IsChecked="True" Checked="SortMode_Changed"/>
                                        <RadioButton x:Name="SortByTypeRadio" Content="Type" GroupName="SortMode"
                                                     Style="{StaticResource SegmentRadio}" Checked="SortMode_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid x:Name="BulkActionsBar" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" Content="Select all" Style="{StaticResource ModernCheckBox}"
                                          VerticalAlignment="Center" Checked="SelectAllCheckBox_Changed" Unchecked="SelectAllCheckBox_Changed"/>
                                <Button x:Name="DownloadSelectedButton" Grid.Column="1" Content="Download selected" Style="{StaticResource SecondaryButton}"
                                        Padding="12,6" Margin="0,0,8,0" IsEnabled="False" Click="DownloadSelectedButton_Click"/>
                                <Button x:Name="InstallSelectedButton" Grid.Column="2" Content="Install selected" Style="{StaticResource PrimaryButton}"
                                        Padding="12,6" IsEnabled="False" Click="InstallSelectedButton_Click"/>
                            </Grid>

                            <StackPanel x:Name="UpdatesListPanel" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- ===================== Settings tab ===================== -->
                <StackPanel x:Name="SettingsTabPanel" Visibility="Collapsed">

                    <!-- Appearance -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="DarkThemeCheckBox" Content="Dark theme" Style="{StaticResource GlowToggle}"
                                      Checked="DarkThemeCheckBox_Changed" Unchecked="DarkThemeCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="AlwaysOnTopCheckBox" Content="Always on top" Style="{StaticResource GlowToggle}"
                                      Checked="AlwaysOnTopCheckBox_Changed" Unchecked="AlwaysOnTopCheckBox_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- Alerts & startup -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Alerts &amp; startup" Style="{StaticResource SectionHeader}"/>

                            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows (minimized to tray)"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="StartWithWindowsCheckBox_Changed" Unchecked="StartWithWindowsCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="ExitOnCloseCheckBox" Content="Exit instead of minimizing to tray when closed"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="ExitOnCloseCheckBox_Changed" Unchecked="ExitOnCloseCheckBox_Changed"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <CheckBox x:Name="TempAlertCheckBox" Content="Notify when CPU or GPU gets too hot"
                                      Style="{StaticResource GlowToggle}"
                                      Checked="TempAlertCheckBox_Changed" Unchecked="TempAlertCheckBox_Changed"/>

                            <Grid Margin="0,14,0,0" IsEnabled="{Binding ElementName=TempAlertCheckBox, Path=IsChecked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Threshold" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="TempAlertSlider" Grid.Column="1" Minimum="60" Maximum="100"
                                        Margin="10,0" Style="{StaticResource ModernSlider}" ValueChanged="TempAlertSlider_ValueChanged"/>
                                <TextBlock x:Name="TempAlertSliderText" Grid.Column="2" Text="85°C" Style="{StaticResource FieldValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- About & support -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="About &amp; support" Style="{StaticResource SectionHeader}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AppVersionText" Grid.Column="0" Text="Version --" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <Button x:Name="CheckForAppUpdateButton" Grid.Column="1" Content="Check for app updates"
                                        Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CheckForAppUpdateButton_Click"/>
                            </Grid>
                            <TextBlock x:Name="AppUpdateStatusText" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                            <Button x:Name="OpenReleasePageButton" Content="View release" Style="{StaticResource SecondaryButton}"
                                    Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Visibility="Collapsed" Click="OpenReleasePageButton_Click"/>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Copy diagnostics" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Copies hardware, driver, and live sensor info to the clipboard for bug reports."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Copy" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        VerticalAlignment="Center" Click="CopyDiagnosticsButton_Click"/>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,14,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Reset to defaults" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="Resets all app preferences (theme, auto-switch, fan curve, alerts, game profiles) back to defaults."/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reset" Style="{StaticResource SecondaryButton}" Padding="14,8"
                                        VerticalAlignment="Center" Click="ResetToDefaultsButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="FooterText" HorizontalAlignment="Center" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                   Text="Closing this window minimizes to the tray. Use the tray icon to exit."/>
        </Grid>
    </Grid>
</Window>
